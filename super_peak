end

--========================================================
-- TOGGLE
--========================================================

Button.Activated:Connect(function()

	Enabled = not Enabled

	if Enabled then

		if not CorePart then
			CreateCore()
		end

		BuildAll()

	else

		ClearAll()

		if CorePart then
			CorePart:Destroy()
			CorePart = nil
			CoreAttachment = nil
		end
	end

	UpdateMenu()
end)

--========================================================
-- PLAYER SETUP
--========================================================

local function SetupPlayer(Player)

	if Player == LP then
		return
	end

	Player.CharacterAdded:Connect(function()

		task.wait(0.5)

		if Enabled then
			CreatePlayer(Player)
		end
	end)

	if Player.Character and Enabled then

		task.defer(function()

			if Enabled then
				CreatePlayer(Player)
			end

		end)
	end
end

for _,Player in ipairs(Players:GetPlayers()) do
	SetupPlayer(Player)
end

Players.PlayerAdded:Connect(function(Player)
	SetupPlayer(Player)
end)

Players.PlayerRemoving:Connect(function(Player)
	RemovePlayer(Player)
end)

--========================================================
-- RESPAWN LOCAL PLAYER
--========================================================

LP.CharacterAdded:Connect(function()

	task.wait(0.5)

	if Enabled and not CorePart then
		CreateCore()
	end

	if Enabled then
		BuildAll()
	end
end)

--========================================================
-- UPDATE LOOP
--========================================================

task.spawn(function()

	while Gui.Parent do

		if Enabled then

			for Player,List in pairs(Effects) do

				if Player.Parent
					and Player.Character then

					UpdatePlayer(Player,List)

				else

					RemovePlayer(Player)
				end
			end
		end

		task.wait(0.08)
	end
end)

--========================================================
