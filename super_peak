--========================================================
-- UPDATE PLAYER
--========================================================

local function UpdatePlayer(Player,List)

	if not Enabled then
		return
	end

	local Character = Player.Character
	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	local Humanoid = Character:FindFirstChildOfClass("Humanoid")

	if not Root or not Humanoid then
		return
	end

	local MyCharacter = LP.Character
	local MyRoot = MyCharacter
		and MyCharacter:FindFirstChild("HumanoidRootPart")

	local Distance = 0

	if MyRoot then
		Distance = math.floor(
			(MyRoot.Position - Root.Position).Magnitude
		)
	end

	local HP = math.floor(
		math.max(0,Humanoid.Health)
	)

	local MaxHP = math.floor(
		math.max(1,Humanoid.MaxHealth)
	)

	for _,Object in ipairs(List) do

		if not Object or not Object.Parent then
			continue
		end

		pcall(function()

			if Object:IsA("Highlight") then

				Object.FillColor = GREEN
				Object.OutlineColor = GREEN

			elseif Object:IsA("BillboardGui") then

				local Label =
					Object:FindFirstChildOfClass("TextLabel")

				if Label then

					Label.Text =
						Player.DisplayName
						.. "\n@"
						.. Player.Name
						.. "\nHP "
						.. HP
						.. " / "
						.. MaxHP
						.. "   "
						.. Distance
						.. "m"

					Label.TextColor3 = GREEN
				end

			elseif Object:IsA("ParticleEmitter") then

				Object.Color =
					ColorSequence.new(GREEN)

			elseif Object:IsA("PointLight") then

				Object.Color = GREEN

			elseif Object:IsA("Beam") then

				Object.Color =
					ColorSequence.new(GREEN)

				Object.Transparency =
					NumberSequence.new(0)

				Object.Width0 =
					BEAM_WIDTH

				Object.Width1 =
					BEAM_WIDTH
			end
		end)
	end
end

--========================================================
-- BUILD
--========================================================

local function BuildAll()

	if not Enabled then
		return
	end

	for _,Player in ipairs(Players:GetPlayers()) do

		if Player ~= LP then

			task.spawn(function()

				if Enabled and Player.Parent then
					CreatePlayer(Player)
				end

			end)
		end
	end
end

--========================================================
-- CLEAR
--========================================================

local function ClearAll()

	for Player in pairs(Effects) do
		RemovePlayer(Player)
	end

	table.clear(Effects)
end

