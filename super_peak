local function RemovePlayer(Player)

	local List = Effects[Player]

	if not List then
		return
	end

	for _,Object in ipairs(List) do
		if Object then
			pcall(function()
				Object:Destroy()
			end)
		end
	end

	Effects[Player] = nil
end

