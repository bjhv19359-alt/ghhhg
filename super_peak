--========================================================

local function MakeParticle(
	Parent,
	Name,
	Texture,
	Rate,
	Life,
	Size
)

	local P = Instance.new("ParticleEmitter")

	P.Name = Name
	P.Texture = Texture
	P.Rate = Rate
	P.Lifetime = Life
	P.Size = Size

	P.Speed = NumberRange.new(0.05,0.8)
	P.SpreadAngle = Vector2.new(180,180)

	P.LightEmission = 1
	P.LightInfluence = 0

	P.Rotation = NumberRange.new(0,360)
	P.RotSpeed = NumberRange.new(-80,80)

	P.Color = ColorSequence.new(GREEN)

	P.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0,1),
		NumberSequenceKeypoint.new(0.15,0.05),
		NumberSequenceKeypoint.new(0.5,0.15),
		NumberSequenceKeypoint.new(0.8,0.5),
		NumberSequenceKeypoint.new(1,1)
	})

	P.Parent = Parent

	return P
end

--========================================================
-- CORE
--========================================================

local function CreateCore()

	if CorePart then
		CorePart:Destroy()
	end

	CorePart = nil
	CoreAttachment = nil

	local Character = LP.Character
	if not Character then
		return
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")
	if not Root then
		return
	end

	if not CorePosition then
		CorePosition = Root.Position + Vector3.new(0,3,0)
	end

	CorePart = Instance.new("Part")
	CorePart.Name = "FixedCosmicCore"
	CorePart.Shape = Enum.PartType.Ball
	CorePart.Size = Vector3.new(
		CORE_SIZE,
		CORE_SIZE,
		CORE_SIZE
	)

	CorePart.Position = CorePosition
	CorePart.Anchored = true
	CorePart.CanCollide = false
	CorePart.CanTouch = false
	CorePart.CanQuery = false
	CorePart.Material = Enum.Material.Neon
	CorePart.Color = GREEN
	CorePart.Transparency = 0
	CorePart.Parent = Folder

	local Light = Instance.new("PointLight")
	Light.Name = "CoreGlow"
	Light.Color = GREEN
	Light.Brightness = 5
	Light.Range = 18
	Light.Shadows = false
	Light.Parent = CorePart

	CoreAttachment = Instance.new("Attachment")
	CoreAttachment.Name = "CoreAttachment"
	CoreAttachment.Parent = CorePart

	MakeParticle(
		CoreAttachment,
		"CoreStars",
		"rbxasset://textures/particles/sparkles_main.dds",
		40,
		NumberRange.new(0.5,1.2),
		NumberSequence.new({
			NumberSequenceKeypoint.new(0,0),
			NumberSequenceKeypoint.new(0.3,0.08),
			NumberSequenceKeypoint.new(0.5,0.35),
			NumberSequenceKeypoint.new(0.8,0.08),
			NumberSequenceKeypoint.new(1,0)
		})
	)
end

CreateCore()

